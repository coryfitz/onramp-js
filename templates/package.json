{
  "name": "onramp-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx onramp-js run android",
    "ios": "npx onramp-js run ios",
    "mobile": "npx onramp-js run mobile",
    "start:native": "node scripts/build-routes.js && npx metro start",
    "start:rn": "npx react-native start",
    "start:web": "node scripts/build-routes.js && webpack serve",
    "build:web": "node scripts/build-routes.js && webpack --mode production",
    "start": "npm run start:native",
    "web": "npm run start:web",
    "build:routes": "node scripts/build-routes.js",
    "typecheck": "node scripts/build-routes.js && tsc --noEmit",
    "test": "node scripts/build-routes.js && jest --runInBand"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.14.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "4.24.0",
    "react-strict-dom": "^0.0.44"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@stylexjs/babel-plugin": "^0.14.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^6.0.0",
    "babel-loader": "^9.1.0",
    "html-webpack-plugin": "^5.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.3",
    "prettier": "^2.8.8",
    "chokidar": "^3.5.3",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "roots": [
      "<rootDir>/app",
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "modulePathIgnorePatterns": [
      "/.onramp/backups/",
      "/ios/",
      "/android/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-strict-dom|@stylexjs|onramp-js)/)"
    ],
    "watchman": false
  },
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "packageManager": "npm@10"
}
